# ============================================
# Environment Configuration Example
# ============================================

APP_ENV=DEVELOPMENT

# ============================================
# Django Core
# ============================================
SECRET_KEY=<DJANGO_SECRET_KEY>
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal,<LOCAL_IP>

# ============================================
# Database (PostgreSQL)
# ============================================
DB_ENGINE=django.db.backends.postgresql
DB_HOST=<DB_HOST_NAME>
DB_PORT=<DB_PORT_NUMBER>
POSTGRES_USER=<DB_USERNAME>
POSTGRES_PASSWORD=<DB_PASSWORD>
POSTGRES_DB=<DB_NAME>

# ============================================
# pgAdmin Configuration
# ============================================
PGADMIN_DEFAULT_EMAIL=<PGADMIN_DEFAULT_EMAIL>
PGADMIN_DEFAULT_PASSWORD=<PGADMIN_DEFAULT_PASSWORD>

# ============================================
# RabbitMQ Configuration
# ============================================
RABBITMQ_HOST=<RABBITMQ_HOST>
RABBITMQ_PORT=5672
RABBITMQ_USER=<RABBITMQ_USER>
RABBITMQ_PASSWORD=<RABBITMQ_PASSWORD>
RABBITMQ_VHOST=/

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET_KEY=<JWT_SECRET_KEY>
JWT_ALGORITHM=HS256

# ============================================
# Observability: Logs & Traces
# ============================================
LOG_SERVER=<LOKI_ENDPOINT>/loki/api/v1/push
OTEL_LOG_COLLECTOR=<OTEL_COLLECTOR_ENDPOINT>/v1/logs
OTEL_TRACE_COLLECTOR=<OTEL_COLLECTOR_ENDPOINT>/v1/traces
